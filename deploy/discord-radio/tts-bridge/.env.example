# Operator-selected on-air voice. IVONA Maxim remains an unverified future target.
TTS_BACKEND=rhvoice
TTS_RHVOICE_VOICE=mikhail
# Enable only installed station-owned profiles; the HTTP caller cannot select others.
# TTS_RHVOICE_ALLOWED_VOICES=mikhail,arina,pavel,yuriy,evgeniy-rus,victoria
TTS_PORT=8092
TTS_MAX_TEXT_CHARS=600
TTS_TIMEOUT_SECONDS=45
TTS_MAX_WAV_BYTES=33554432
# Set the same secret on the radio client. Leave unset only on a private network.
# TTS_TOKEN=replace-with-a-long-random-value

# Piper remains a diagnostic alternative in the separate legacy Dockerfile, not
# the voice selected for this station. Do not set these in the RHVoice image.
TTS_PIPER_BINARY=/usr/local/bin/piper
TTS_PIPER_MODEL=/runtime/piper/ru_RU-dmitri-medium.onnx
TTS_PIPER_CONFIG=/runtime/piper/ru_RU-dmitri-medium.onnx.json
# TTS_PIPER_SPEAKER=0

# IVONA/Wine alternative. This is JSON argv, not a shell command. The wrapper is
# operator-supplied and must read UTF-8 input and emit a WAV. Mount all licensed
# files read-only; none are included in this repository or image.
# Set TTS_BACKEND=ivona only after the licensed runtime passes the Ubuntu/Wine probe.
# TTS_IVONA_COMMAND_JSON=["wine","/runtime/ivona/synthesize.exe","--text-file","{text_file}","--output","{output_file}","--voice","{voice}"]
