DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_OWNER_IDS=
# Root owner is this one Discord account; it may appoint admins by command.

RADIO_MAX_GUILDS=3
RADIO_CACHE_MAX_MB=1024
TTS_CACHE_MAX_MB=256
RADIO_STATION_NAME=HexWave Radio
# Compose exposes /live.mp3 only on host loopback (127.0.0.1:9380).
RADIO_HTTP_STREAM_ENABLED=true
RADIO_JINGLE_EVERY_MINUTES=30
REQUEST_COOLDOWN_MINUTES=15
STUDIO_COOLDOWN_MINUTES=15

# Tooken Club is the sole AI gateway; never put an OpenAI project key here.
OPENAI_BASE_URL=https://tooken.club/v1
TOOKEN_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_MS=45000
OPENAI_HOURLY_LIMIT=0
OPENAI_DAILY_LIMIT=0

# Enable the tts profile and set this to http://tts:8092 when its private runtime is mounted.
TTS_BASE_URL=
TTS_VOICE=mikhail
TTS_TOKEN=

# Enable the spotify profile and configure all four client-side values together.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_SHIM_BASE_URL=
PLAYOUT_BRIDGE_SECRET=
SPOTIFY_SHIM_SECRET=
